# Resend — copy to .env.local and fill in your values
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
# With onboarding@resend.dev, TO must match the email on your Resend account.
# After verifying a domain, use your custom FROM and any TO address.
RESEND_TO_EMAIL=your-resend-account-email@example.com
